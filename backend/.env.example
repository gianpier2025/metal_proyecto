# Servidor Express
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase proyecto metal_proyecto
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Conexión PostgreSQL de Supabase. En Render, usa el pooler de transacciones.
# Reemplaza la contraseña por la contraseña de la base de datos de este proyecto.
DATABASE_URL=postgresql://postgres.PROJECT-REF:DB-PASSWORD@POOLER-HOST:6543/postgres
# Descarga el CA raíz desde Supabase > Project Settings > Database > SSL Configuration
# y guárdalo como backend/prod-ca-2021.crt. La ruta es relativa a la carpeta backend.
DATABASE_SSL_CA_PATH=prod-ca-2021.crt
DB_POOL_MAX=10

# Opcional: requerido solo para invitar usuarios desde el endpoint admin del backend.
# Nunca pongas esta clave en frontend/.env ni en archivos versionados.
SUPABASE_SECRET_KEY=
AUTH_REDIRECT_URL=http://localhost:5173/?action=set-password
